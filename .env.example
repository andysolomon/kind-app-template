# Copy to .env at the repo root. Alchemy reads it for the local `live` stage
# only. Values stay out of git and out of logs. An empty file is fine: the
# sample app boots with no secrets.
#
# List a key in `secretKeys` in infra/app.config.ts before it is copied into
# the cluster. Unlisted keys are ignored.
# EXAMPLE_TOKEN=replace-me

# Named Cloudflare Tunnel only (`publish: "named"`). The token is mounted into
# cloudflared, not into the app, and is never printed.
# CLOUDFLARE_TUNNEL_TOKEN=
